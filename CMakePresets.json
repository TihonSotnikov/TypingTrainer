{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "dev",
            "displayName": "Debug + тесты",
            "description": "Отладочная сборка приложения и автотестов",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TT_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "core",
            "displayName": "Ядро + тесты (без Qt)",
            "description": "Собирает только backend и автотесты, Qt не нужен",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TT_BUILD_APP": "OFF",
                "TT_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "configuration": "Debug"
        },
        {
            "name": "core",
            "configurePreset": "core",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "core",
            "configurePreset": "core",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
